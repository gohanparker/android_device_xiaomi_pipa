android_app {
    name: "CleanRamTile",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "com.derp.cleanram.xml",

    optimize: {
        enabled: false,
    },
}
